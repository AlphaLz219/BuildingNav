<?xml version="1.0"?>
<!-- Gazebo world for TurtleBot3 in competition building -->
<sdf version="1.6">
  <world name="turtlebot3_exploration">
    <include>
      <uri>model://sun</uri>
    </include>

    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- Include the competition building -->
    <include>
      <uri>model://competition_scene</uri>
    </include>

    <!-- TurtleBot3 Waffle Pi -->
    <include>
      <uri>model://turtlebot3_waffle_pi</uri>
      <name>turtlebot3</name>
      <pose>0 0 0.0 0 0 0</pose>
    </include>

    <gui fullscreen='0'>
      <camera name='user_camera'>
        <pose>-5 -5 3 0 0.5 4.71</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>
  </world>
</sdf>
