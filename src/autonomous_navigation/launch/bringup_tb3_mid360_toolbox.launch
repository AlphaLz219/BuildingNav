<?xml version="1.0" ?>
<launch>
  <!-- ======================== 参数 ======================== -->
  <arg name="world_file"   default="$(find autonomous_navigation)/../../generated_building/competition_scene.world"
                           doc="比赛场景世界文件"/>
  <arg name="robot_x"      default="0.0"    doc="机器人出生点 X (m)"/>
  <arg name="robot_y"      default="2.0"   doc="机器人出生点 Y (m)"/>
  <arg name="robot_z"      default="0.0"    doc="机器人出生点 Z (m)"/>
  <arg name="robot_yaw"    default="1.5708" doc="机器人朝向 yaw (rad)，默认 π/2 面朝建筑入口"/>
  <arg name="gui"          default="true"/>
  <arg name="paused"       default="false"/>
  <arg name="use_sim_time" default="true"/>

  <!-- ============= 设置模型路径（generated_building/models） ============= -->
  <env name="GAZEBO_MODEL_PATH"
       value="$(find autonomous_navigation)/../../generated_building:$(optenv GAZEBO_MODEL_PATH)"/>

  <!-- ============= 1. 启动 Gazebo + 比赛世界 ============= -->
  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="world_name"   value="$(arg world_file)"/>
    <arg name="paused"       value="$(arg paused)"/>
    <arg name="use_sim_time" value="$(arg use_sim_time)"/>
    <arg name="gui"          value="$(arg gui)"/>
    <arg name="headless"     value="false"/>
    <arg name="debug"        value="false"/>
  </include>

  <!-- ============= 2. 加载定制 TB3+Mid360 模型 ============= -->
  <param name="robot_description"
         command="$(find xacro)/xacro
                  $(find autonomous_navigation)/urdf/turtlebot3_burger.urdf.xacro" />

  <!-- ============= 3. Spawn 机器人 ============= -->
  <node pkg="gazebo_ros" type="spawn_model" name="spawn_tb3_mid360"
        args="-urdf -model tb3_mid360
              -x $(arg robot_x) -y $(arg robot_y) -z $(arg robot_z)
              -Y $(arg robot_yaw)
              -param robot_description" />

  <!-- ============= 4. 发布 TF ============= -->
  <node pkg="robot_state_publisher" type="robot_state_publisher"
        name="robot_state_publisher">
    <param name="publish_frequency" value="30.0"/>
  </node>

  <!-- ============= 5. 点云格式转换：PointCloud → PointCloud2 ============= -->
  <!--     Mid360 插件输出旧版 PointCloud，pointcloud_to_laserscan 需要 PointCloud2  -->
  <node pkg="autonomous_navigation" type="pointcloud_converter.py"
        name="pointcloud_converter" output="screen"/>

  <!-- ============= 5.5 水平激光坐标系（确保投影面严格水平） ========= -->
  <!--     Mid360 安装有 45° 俯仰，pointcloud_to_laserscan 要求 target_frame Z 轴竖直 -->
  <!--     创建与 base_link 平行的虚拟坐标系，位于 laser_livox 相同位置        -->
  <node pkg="tf" type="static_transform_publisher"
        name="laser_livox_level_tf"
        args="0.04 0 0.4 0 0 0 base_link laser_livox_level 100"/>

  <!-- ============= 6. 3D 点云 → 2D 激光扫描（供 SLAM 建图使用） ========= -->
  <node pkg="pointcloud_to_laserscan" type="pointcloud_to_laserscan_node"
        name="pointcloud_to_laserscan">
    <remap from="cloud_in"  to="/scan2"/>
    <remap from="scan"      to="/scan_2d"/>

    <param name="target_frame"        value="laser_livox_level"/>
    <param name="transform_tolerance" value="0.05"/>
    <!-- 雷达距地 ~0.41m，地板 z≈-0.41，取 -0.35~0.10 捕获墙壁立面（地面上方6~51cm） -->
    <param name="min_height"          value="-0.35"/>
    <param name="max_height"          value="0.10"/>
    <param name="angle_min"           value="-3.14159"/>
    <param name="angle_max"           value="3.14100"/>
    <param name="angle_increment"     value="0.005812"/>
    <param name="range_min"           value="0.1"/>
    <param name="range_max"           value="30.0"/>
    <param name="concurrency_level"   value="1"/>
  </node>

  <!-- ============= 7. slam_toolbox 在线建图 ============= -->
  <node pkg="slam_toolbox" type="async_slam_toolbox_node" name="slam_toolbox" output="screen">
    <remap from="scan" to="/scan_2d"/>

    <param name="odom_frame"  value="odom"/>
    <param name="map_frame"   value="map"/>
    <param name="base_frame"  value="base_footprint"/>

    <param name="mode"              value="mapping"/>
    <param name="map_start_pose"    value="[0.0, 2.0, 0.0]"/>
    <param name="map_start_at_dock" value="false"/>

    <param name="map_update_interval"      value="0.5"/>
    <param name="transform_publish_period" value="0.05"/>

    <param name="minimum_travel_distance" value="0.1"/>
    <param name="minimum_travel_heading"  value="0.05"/>
    <param name="scan_buffer_size"        value="10"/>
    <param name="minimum_time_interval"   value="0.3"/>

    <param name="link_match_minimum_response_fine" value="0.6"/>
    <param name="link_scan_max_distance"           value="0.3"/>

    <param name="correlation_search_space_dimension"  value="0.02"/>
    <param name="correlation_search_space_resolution" value="0.01"/>

    <param name="do_loop_closing"                    value="true"/>
    <param name="loop_match_minimum_chain_size"      value="10"/>
    <param name="loop_search_max_distance"           value="3.0"/>
    <param name="loop_match_minimum_response_coarse" value="0.35"/>
    <param name="loop_match_minimum_response_fine"   value="0.45"/>

    <param name="resolution"          value="0.05"/>
    <param name="max_laser_range"     value="15.0"/>
    <param name="transform_timeout"   value="0.2"/>
    <param name="tf_buffer_duration"  value="30.0"/>
  </node>

  <!-- ============= 8. RViz 可视化 ============= -->
  <arg name="rviz" default="false"/>
  <node pkg="rviz" type="rviz" name="rviz"
        args="-d $(find autonomous_navigation)/rviz/nav_mapping.rviz"
        if="$(arg rviz)"/>

</launch>
