<?xml version="1.0" ?>
<launch>
  <!-- ==================================================================
       bringup_a1_mapping.launch
       A1 机器狗 slam_toolbox 建图 + 导航启动文件

       前置条件：先运行 auto.sh 启动 Gazebo + A1 模型 + 控制器
         ./auto.sh

       本 launch 启动：
         1. 静态 TF（base→laser_livox_level）+ cmd_vel_odom 航位推算里程计（odom→base + /odom）
         2. slam_toolbox 建图（包含在 slam_toolbox.launch 中）
         3. move_base 导航
         4. 前沿探索节点
         5. RViz 可视化

       TF 链：map → odom(slam_toolbox) → base(cmd_vel_odom) → laser_livox_level(静态)
       ================================================================== -->

  <arg name="rviz" default="true"/>
  <arg name="load_state" default="" doc="加载已保存的走廊状态文件路径（留空则从头开始）"/>

  <!-- 仿真环境下使用 Gazebo sim time，保证 scan 与 TF 时间戳一致 -->
  <param name="/use_sim_time" value="true"/>

  <!-- ============= 1. 水平激光坐标系 ============= -->
  <!-- Livox Mid-360 安装在 base 上（水平安装，无倾斜）。
       创建 laser_livox_level 坐标系与 laser_livox 重合，保持一致性。 -->
  <!-- 静态变换：tf2_ros 的 static_transform_publisher 不带周期参数时
       发布到 /tf_static 并保持运行（tf 包的同名节点会发一次后退出）。
       这样 hector_mapping 在任何时间戳查 map→laser_livox_level 都不会失败。 -->
  <node pkg="tf2_ros" type="static_transform_publisher"
        name="laser_livox_level_tf"
        args="0.2 0 0.08 0 0 0 base laser_livox_level"/>

  <!-- odom→base 航位推算伪里程计（cmd_vel_odom.py）：
       A1 Estimator 的位置状态在 Gazebo 仿真中不积分（速度准、位置不动），
       故停用其 odom→base / /odom 发布（见 Estimator.cpp），
       改用 /cmd_vel 指令速度 + /trunk_imu 朝向做航位推算。
       TF 链：map→odom(slam_toolbox) → odom→base(cmd_vel_odom) → base→laser_livox(静态) -->
  <node pkg="autonomous_navigation" type="cmd_vel_odom.py"
        name="cmd_vel_odom" output="screen"/>

  <!-- ============= 2. LaserScan 直接使用 ============= -->
  <!-- Gazebo 标准 libgazebo_ros_laser.so 直接发布 /scan (LaserScan)，
       slam_toolbox 直接消费，无需中间转换。 -->

  <!-- ============= 3. slam_toolbox 建图 ============= -->
  <!-- 独立 launch 文件，多楼层切换时通过重启节点实现会话重置。
       map_start_pose 确保每次重启地图方向一致。 -->
  <include file="$(find autonomous_navigation)/launch/slam_toolbox.launch"/>

  <!-- ============= 4. Move Base 导航 ============= -->
  <node pkg="move_base" type="move_base" name="move_base" respawn="false" output="screen">
    <remap from="odom" to="/odom"/>
    <rosparam file="$(find autonomous_navigation)/config/navigation_a1/costmap_common_params.yaml"
              command="load" ns="global_costmap"/>
    <rosparam file="$(find autonomous_navigation)/config/navigation_a1/costmap_common_params.yaml"
              command="load" ns="local_costmap"/>
    <rosparam file="$(find autonomous_navigation)/config/navigation_a1/global_costmap_params.yaml"
              command="load"/>
    <rosparam file="$(find autonomous_navigation)/config/navigation_a1/local_costmap_params.yaml"
              command="load"/>
    <rosparam file="$(find autonomous_navigation)/config/navigation_a1/global_planner_params.yaml"
              command="load"/>
    <rosparam file="$(find autonomous_navigation)/config/navigation_a1/dwa_local_planner_params.yaml"
              command="load"/>
    <!-- <rosparam file="$(find autonomous_navigation)/config/navigation_a1/base_local_planner_params.yaml"
              command="load"/> -->
    <rosparam file="$(find autonomous_navigation)/config/navigation_a1/move_base_params.yaml"
              command="load"/>
  </node>

  <!-- ============= 5. 前沿探索节点 ============= -->
  <node pkg="autonomous_navigation" type="frontier_exploration_a1.py"
        name="frontier_exploration" output="screen">
    <rosparam file="$(find autonomous_navigation)/config/exploration_params.yaml"
              command="load"/>
    <param name="save_state_path" value="$(find autonomous_navigation)/../../maps/corridor_state.json"/>
    <param name="load_state_path" value="$(arg load_state)"/>
    <param name="scene_info_path" value="$(find autonomous_navigation)/../../generated_building/team_scene_info.json"/>
    <!-- slam_toolbox 多楼层会话管理 -->
    <param name="slam_launch_pkg" value="autonomous_navigation"/>
    <param name="slam_launch_file" value="slam_toolbox.launch"/>
    <param name="floor_session_dir" value="$(find autonomous_navigation)/../../maps/floor_sessions"/>
  </node>

  <!-- ============= 6. RViz ============= -->
  <node pkg="rviz" type="rviz" name="rviz_mapping"
        args="-d $(find autonomous_navigation)/rviz/a1_mapping.rviz"
        if="$(arg rviz)"/>

</launch>
