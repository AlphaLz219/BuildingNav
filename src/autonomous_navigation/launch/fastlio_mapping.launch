<?xml version="1.0" ?>
<!-- Fast-LIO2 3D 建图：TB3 + Mid360 -->
<launch>
  <arg name="rviz" default="true"/>

  <!-- 加载 LiDAR/IMU 外参配置 -->
  <rosparam command="load"
            file="$(find autonomous_navigation)/config/tb3_mid360_fastlio.yaml"/>

  <!-- Fast-LIO 参数 -->
  <param name="feature_extract_enable" type="bool"  value="0"/>
  <param name="point_filter_num"       type="int"   value="1"/>    <!-- 2→1，多留点 -->
  <param name="max_iteration"          type="int"   value="4"/>    <!-- 3→4，多迭代一次 -->
  <param name="filter_size_surf"       type="double" value="0.2"/> <!-- 0.3→0.2，更细 -->
  <param name="filter_size_map"        type="double" value="0.2"/>

  <!-- Fast-LIO 核心节点 -->
  <node pkg="fast_lio" type="fastlio_mapping"
        name="laserMapping" output="screen"/>

  <!-- 帧名映射: Fast-LIO 坐标系 → 标准 nav 坐标系 -->
  <!--   body = base_footprint（Fast-LIO 定位 → 机器人底盘位姿）      -->
  <!--   slam_toolbox 用 camera_init 做 odom_frame，不引入多余帧       -->
<node pkg="tf" type="static_transform_publisher"
      name="body_to_base_tf"
      args="-0.017 0.023 -0.261 0 0 0 body base_footprint 100"/>

  <!-- slam_toolbox: /scan_2d + Fast-LIO odometry → /map + map→camera_init -->
  <node pkg="slam_toolbox" type="async_slam_toolbox_node"
        name="slam_toolbox" output="screen">
    <remap from="scan" to="/scan_2d"/>

    <param name="map_frame"  value="map"/>
    <param name="odom_frame" value="camera_init"/>
    <param name="base_frame" value="base_footprint"/>

    <param name="mode" value="mapping"/>
    <param name="resolution" value="0.05"/>
    <param name="max_laser_range" value="15.0"/>
    <param name="minimum_time_interval" value="0.1"/>
    <param name="minimum_travel_distance" value="0.05"/>
    <param name="minimum_travel_heading" value="0.05"/>
    <param name="do_loop_closing" value="true"/>
    <param name="transform_timeout" value="0.2"/>
    <param name="tf_buffer_duration" value="30.0"/>

    <!-- 走廊稳定性：扩大搜索空间 + 放宽匹配门槛 -->
    <param name="correlation_search_space_dimension" value="0.5"/>
    <param name="correlation_search_space_resolution" value="0.01"/>
    <param name="link_match_minimum_response_fine" value="0.05"/>
    <param name="link_scan_max_distance" value="2.0"/>
  </node>

  <!-- RViz -->
  <group if="$(arg rviz)">
    <node launch-prefix="nice" pkg="rviz" type="rviz" name="rviz"
          args="-d $(find autonomous_navigation)/rviz/fastlio.rviz"/>
  </group>
</launch>
