<?xml version="1.0" ?>
<!-- Fast-LIO2 3D 建图：TB3 + Mid360 -->
<launch>
  <arg name="rviz" default="true"/>

  <!-- 加载 LiDAR/IMU 外参配置 -->
  <rosparam command="load"
            file="$(find autonomous_navigation)/config/tb3_mid360_fastlio.yaml"/>

  <!-- Fast-LIO 参数 -->
  <param name="feature_extract_enable" type="bool"  value="0"/>
  <param name="point_filter_num"       type="int"   value="1"/>    <!-- 2→1，多留点 -->
  <param name="max_iteration"          type="int"   value="4"/>    <!-- 3→4，多迭代一次 -->
  <param name="filter_size_surf"       type="double" value="0.2"/> <!-- 0.3→0.2，更细 -->
  <param name="filter_size_map"        type="double" value="0.2"/>

  <!-- Fast-LIO 核心节点 -->
  <node pkg="fast_lio" type="fastlio_mapping"
        name="laserMapping" output="screen"/>

  <!-- TF 桥接: camera_init → odom（Fast-LIO 定位映射到 Gazebo 世界）
  <node pkg="autonomous_navigation" type="tf_bridge.py"
        name="tf_bridge" output="screen"/> -->

    <!-- 静态映射: map → odom → camera_init → body → base_footprint -->
  <node pkg="tf" type="static_transform_publisher"
        name="map_to_odom_tf"
        args="0 0 0 0 0 0 map odom 100"/>
  <node pkg="tf" type="static_transform_publisher"
        name="odom_to_camera_tf"
        args="0 0 0 0 0 0 odom camera_init 100"/>
  <node pkg="tf" type="static_transform_publisher"
        name="body_to_base_tf"
        args="-0.017 0.02329 -0.26112 0 0 0 body base_footprint 100"/>
  <!-- <node pkg="autonomous_navigation" type="lio_to_base.py"
      name="lio_to_base" output="screen"/>       -->

  <!-- 3D 点云 → 2D 占据栅格投影 -->
  <node pkg="autonomous_navigation" type="pointcloud_to_2d_map.py"
        name="pointcloud_to_2d_map" output="screen"/>

  <!-- RViz -->
  <group if="$(arg rviz)">
    <node launch-prefix="nice" pkg="rviz" type="rviz" name="rviz"
          args="-d $(find autonomous_navigation)/rviz/fastlio.rviz"/>
  </group>
</launch>
