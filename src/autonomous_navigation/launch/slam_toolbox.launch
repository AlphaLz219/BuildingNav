<?xml version="1.0"?>
<launch>
  <!-- ============= slam_toolbox 在线建图（独立 launch） ============= -->
  <!-- 独立成文件的原因：多楼层切换时通过重启该节点实现会话重置
       （Noetic 版 slam_toolbox 无 /slam_toolbox/reset 服务）。
       重启后 SLAM 用 map_start_pose=(0,0.5,0) 初始化 → 标准帧，
       机器人被定位到新地图 (0, 0.5)，所有非启动楼层的帧一致。 -->

  <node pkg="slam_toolbox" type="async_slam_toolbox_node" name="slam_toolbox" output="screen">
    <remap from="scan" to="/scan_2d"/>

    <param name="odom_frame"  value="odom"/>
    <param name="map_frame"   value="map"/>
    <param name="base_frame"  value="base_footprint"/>

    <param name="map_start_pose"    value="[0.0, 0.5, 0.0]"/>
    <param name="map_start_at_dock" value="false"/>

    <param name="map_update_interval"      value="0.5"/>
    <param name="transform_publish_period" value="0.05"/>

    <param name="minimum_travel_distance" value="0.15"/>
    <param name="minimum_travel_heading"  value="0.15"/>
    <param name="scan_buffer_size"        value="10"/>
    <param name="minimum_time_interval"   value="0.2"/>

    <param name="link_match_minimum_response_fine" value="0.7"/>
    <param name="link_scan_max_distance"           value="0.3"/>

    <param name="correlation_search_space_dimension"  value="0.02"/>
    <param name="correlation_search_space_resolution" value="0.01"/>

    <param name="do_loop_closing"                    value="false"/>
    <param name="loop_match_minimum_chain_size"      value="10"/>
    <param name="loop_search_max_distance"           value="10.0"/>
    <param name="loop_match_minimum_response_coarse" value="0.35"/>
    <param name="loop_match_minimum_response_fine"   value="0.45"/>

    <param name="resolution"          value="0.05"/>
    <param name="max_laser_range"     value="15.0"/>
    <param name="transform_timeout"   value="0.2"/>
    <param name="tf_buffer_duration"  value="30.0"/>
  </node>
</launch>
