Panels:
  - Class: rviz/Displays
    Name: Displays
  - Class: rviz/Tool Properties
    Name: Tool Properties
  - Class: rviz/Views
    Name: Views
  - Class: rviz/Time
    Name: Time
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz/Grid
      Color: 160; 160; 164
      Enabled: true
      Line Style:
        Line Width: 0.03
        Value: Lines
      Name: Grid
      Plane: XY
      Plane Cell Count: 50
      Reference Frame: <Fixed Frame>
      Value: true

    - Class: rviz/TF
      Enabled: true
      Frame Timeout: 15
      Marker Alpha: 1
      Marker Scale: 0.5
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Update Interval: 0
      Value: true

    - Alpha: 1.0
      Class: rviz/Map
      Color Scheme: map
      Draw Behind: true
      Enabled: true
      Name: Static Map
      Topic: /map
      Value: true

    - Alpha: 0.1
      Class: rviz/Map
      Color Scheme: costmap
      Draw Behind: true
      Enabled: true
      Name: Global Costmap
      Topic: /move_base/global_costmap/costmap
      Value: true

    - Alpha: 0.1
      Class: rviz/Map
      Color Scheme: costmap
      Draw Behind: true
      Enabled: true
      Name: Local Costmap
      Topic: /move_base/local_costmap/costmap
      Value: true

    - Alpha: 1
      Class: rviz/Path
      Color: 0; 255; 0
      Enabled: true
      Name: Global Plan
      Topic: /move_base/GlobalPlanner/plan
      Value: true

    - Alpha: 1
      Class: rviz/Path
      Color: 255; 255; 0
      Enabled: true
      Name: Local Plan
      Topic: /move_base/DWAPlannerROS/local_plan
      Value: true

    # ===== 前沿探索可视化 =====
    # 前沿簇标记（绿色球体 = 可选前沿，红色 = 当前选中目标）
    - Class: rviz/MarkerArray
      Enabled: true
      Name: Frontier Markers
      Marker Topic: /frontier_markers
      Queue Size: 100
      Value: true

    # 当前探索目标（橙色柱体）
    - Class: rviz/Marker
      Enabled: true
      Name: Current Goal
      Marker Topic: /current_goal_marker
      Queue Size: 10
      Value: true

    - Alpha: 1
      Autocompute Intensity Bounds: true
      Class: rviz/LaserScan
      Color: 255; 0; 0
      Color Transformer: FlatColor
      Enabled: true
      Name: LaserScan 2D
      Size (Pixels): 3
      Style: Points
      Topic: /scan_2d
      Value: true

    - Alpha: 1
      Class: rviz/RobotModel
      Enabled: true
      Name: Robot Model
      Robot Description: robot_description
      Value: true

  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/MoveCamera
    - Class: rviz/SetGoal
      Topic: /move_base_simple/goal
  Value: true
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 25
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Name: Current View
      Pitch: 0.7854
      Target Frame: <Fixed Frame>
      Yaw: 0
Window Geometry:
  Height: 1016
  Width: 1920
