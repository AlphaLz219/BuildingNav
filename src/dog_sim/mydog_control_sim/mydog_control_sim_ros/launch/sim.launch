<?xml version="1.0" ?>
<launch>

  <arg name="rname" default="ask_3"/>
  <arg name="robot_path" value="(find $(arg rname)_description)"/>
  <arg name="dollar" value="$"/>
  <!-- Parameters for Gazebo -->
  <!-- If launch Gazebo GUI -->
  <arg name="gazebo_gui" default="false"/>
  <!-- Start paused -->
  <arg name="paused" default="true"/>
  <!-- Set the initial pose of the robot's main body -->
  <arg name="x" default="0.0"/>
  <arg name="y" default="0.0"/>
  <arg name="z" default="0.4"/>
  <arg name="roll" default="0"/>
  <arg name="pitch" default="0.0"/>
  <arg name="yaw" default="0"/>
  <!-- Name of the world. box.world is a good test world for rough terrain. It cannot handle slopes right now. -->
  <arg name="world" default="empty"/>
  <!-- Path to the world file -->
  <arg name="world_file" default="$(find mydog_gazebo)/worlds/$(arg world).world"/>
  <!-- Model path -->
  <arg name="model_path" default="$(find mydog_gazebo)/models/.."/>
  <arg name="isReal" default="false"/>
  <arg name="useKF" default="false"/>
  <arg name="jsN" default="js0"/>

  <!-- Parameters for trotting_planner -->
  <!-- Swing height of the swing feet -->
  <arg name="stepHeight" default="0.06"/>
  <arg name="stepLength" default="0.0"/>
  <!-- Swing period for swing feet. Unit is second. The range could be [0.2, 0.3] second -->
  <arg name="swingPeriod" default="0.2"/>

  <!-- Select where std::cout/printf/ROS/MELO output is routed to: console (screen) or log file (log).
       Note that std::cerr is always routed to the console. -->
  <arg name="output" default="screen" doc="Output target: screen or log."/>

  <!-- Time step of communication default 400Hz -->
  <arg name="time_step" default="0.02" />
  <arg name="isRealRobot" default="false" />
  <arg name="fixedBase" default="false" />
  <arg name="publish_rate" default="50" />

  <!-- Load Gazebo world -->
  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <env name="GAZEBO_MODEL_PATH" value="$(arg model_path)"/>
    <arg name="paused" value="$(arg paused)"/>
    <arg name="world_name" value="$(arg world_file)"/>
    <arg name="gui" value="$(arg gazebo_gui)"/>
  </include>

  <param if="$(arg fixedBase)" name="robot_description" command="$(find xacro)/xacro '$(arg dollar)$(arg robot_path)/urdf/$(arg rname)_fixedBase.urdf.xacro' " />
  <param unless="$(arg fixedBase)" name="robot_description" command="$(find xacro)/xacro '$(arg dollar)$(arg robot_path)/urdf/$(arg rname).urdf.xacro' " />

  <node name="urdf_spawner" pkg="gazebo_ros" type="spawn_model" respawn="false" output="screen" args="-J RF_KFE 0.0 -J LF_KFE 0.0 -J RH_KFE 0.0 -J LH_KFE 0.0 -urdf -model $(arg rname) -param robot_description -x $(arg x) -y $(arg y) -z $(arg z) -R $(arg roll) -P $(arg pitch) -Y $(arg yaw)"/>

  <!-- Load joint controller configurations from YAML file to parameter server -->
  <rosparam file="$(find mydog_control_sim_ros)/config/$(arg rname)_control.yaml" command="load"/>

  <!-- load the controllers -->
  <node name="controller_spawner" pkg="controller_manager" type="spawner" respawn="false" output="screen" ns="/$(arg rname)" args="joint_state_controller
					                                joint1_position_controller
					                                joint2_position_controller
					                                joint3_position_controller
                                          joint4_position_controller
                                          joint5_position_controller
                                          joint6_position_controller
                                          joint7_position_controller
                                          joint8_position_controller
                                          joint9_position_controller
                                          joint10_position_controller
                                          joint11_position_controller
                                          joint12_position_controller"/>

  <!-- convert joint states to TF transforms for rviz, etc -->
  <node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher" respawn="false" output="screen">
    <remap from="/joint_states" to="/$(arg rname)/joint_states" />
    <param name="publish_frequency" type="double" value="$(arg publish_rate)" />
  </node>

  <!--node pkg="tf" type="static_transform_publisher" name="worldAndOdom" args="0 0 0 0 0 0 world odom 2.5"/-->

  <!--node name="joint_state_publisher" pkg="joint_state_publisher" type="joint_state_publisher">
  	<param name="rate" type="double" value="$(arg publish_rate)" />
  </node-->

  <node name="mydog_control_sim_ros" pkg="mydog_control_sim_ros" type="mydog_control_sim_ros_node" output="$(arg output)">
    <param name="time_step" type="double" value="$(arg time_step)"/>
    <param name="isRealRobot" type="bool" value="$(arg isRealRobot)"/>
    <param name="fixedBase" type="bool" value="$(arg fixedBase)"/>
    <param name="stepHeight" type="double" value="$(arg stepHeight)"/>
    <param name="stepLength" type="double" value="$(arg stepLength)"/>
    <param name="swingPeriod" type="double" value="$(arg swingPeriod)"/>
    <param name="useKF" type="bool" value="$(arg useKF)"/>
    <param name="rname" type="string" value="$(arg rname)"/>
  </node>

  <!--node name="moying_driver_ros_node" pkg="moying_driver_ros" type="moying_driver_ros_node" required="false" output="$(arg output)"  /-->

  <node name="mydog_state_estimator_ros_node" pkg="mydog_state_estimator_ros" type="mydog_state_estimator_ros_node" required="true" output="screen" />

  <include file="$(arg dollar)$(arg robot_path)/launch/rviz.launch" />

  <!-- joy node -->
  <node respawn="true" pkg="joy" type="joy_node" name="joy">
    <param name="dev" type="string" value="/dev/input/$(arg jsN)" />
    <!--param name="deadzone" value="0.12" /-->
  </node>

  <!-- GUI node -->
  <node name="rqt_gui_node" pkg="rqt_gui" type="rqt_gui" respawn="true" output="$(arg output)"
   args = "--perspective-file $(find rqt_dog_gui)/dogRviz_gui.perspective">


  </node >


</launch>
