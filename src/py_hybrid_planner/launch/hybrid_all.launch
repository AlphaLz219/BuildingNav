<launch>
  <!-- One-shot launch: Gazebo + indoor world + TurtleBot3 + navigation stack + RViz.
       Default spawn matches the maps2 experiment: corner near (0, 0) inside the building. -->
  <arg name="model" default="burger"/>
  <arg name="x_pos" default="0.8"/>
  <arg name="y_pos" default="0.8"/>
  <arg name="yaw"   default="0.7854"/>   <!-- 45 deg, facing NE toward opposite corner -->

  <include file="$(find py_hybrid_planner)/launch/indoor_gazebo.launch">
    <arg name="model" value="$(arg model)"/>
    <arg name="x_pos" value="$(arg x_pos)"/>
    <arg name="y_pos" value="$(arg y_pos)"/>
    <arg name="yaw"   value="$(arg yaw)"/>
  </include>

  <include file="$(find py_hybrid_planner)/launch/hybrid_nav.launch">
    <arg name="model"       value="$(arg model)"/>
    <arg name="initial_x"   value="$(arg x_pos)"/>
    <arg name="initial_y"   value="$(arg y_pos)"/>
    <arg name="initial_yaw" value="$(arg yaw)"/>
  </include>
</launch>
