<launch>
  <!--
    Stage 2: navigation stack (map + AMCL + hybrid planner + RViz).

    Assumes indoor_gazebo.launch is already running in a separate terminal
    (or use hybrid_all.launch to bring everything up at once).
  -->
  <arg name="model"    default="burger"/>
  <arg name="map_file" default="$(find py_hybrid_planner)/maps/map.yaml"/>
  <arg name="open_rviz" default="true"/>

  <!-- spawn pose must match indoor_gazebo.launch -->
  <arg name="initial_x"   default="0.8"/>
  <arg name="initial_y"   default="0.8"/>
  <arg name="initial_yaw" default="0.7854"/>

  <env name="TURTLEBOT3_MODEL" value="$(arg model)"/>

  <!-- Map server -->
  <node name="map_server" pkg="map_server" type="map_server"
        args="$(arg map_file)"/>

  <!-- AMCL adaptive Monte-Carlo localisation.
       Tuning notes:
       - recovery_alpha_slow/fast > 0 enables global recovery from divergence.
       - 5000 max particles + KLD sampling keeps CPU bounded while still
         giving enough particle diversity for a 10x10m indoor map.
       - transform_tolerance 0.2s matches the 15 Hz control loop.
       - odom alphas are tuned for TurtleBot3 burger differential drive,
         which produces noisier wheel odometry in Gazebo than the default
         params assume. Larger alpha1/alpha2 lets AMCL trust laser more. -->
  <node pkg="amcl" type="amcl" name="amcl" output="screen">
    <param name="min_particles"             value="800"/>
    <param name="max_particles"             value="5000"/>
    <param name="kld_err"                   value="0.02"/>
    <param name="kld_z"                     value="0.99"/>
    <param name="update_min_d"              value="0.15"/>
    <param name="update_min_a"              value="0.15"/>
    <param name="resample_interval"         value="2"/>
    <param name="transform_tolerance"       value="0.2"/>
    <param name="recovery_alpha_slow"       value="0.001"/>
    <param name="recovery_alpha_fast"       value="0.1"/>
    <param name="gui_publish_rate"          value="10.0"/>
    <param name="save_pose_rate"            value="0.5"/>

    <param name="initial_pose_x"            value="$(arg initial_x)"/>
    <param name="initial_pose_y"            value="$(arg initial_y)"/>
    <param name="initial_pose_a"            value="$(arg initial_yaw)"/>
    <param name="initial_cov_xx"            value="0.25"/>
    <param name="initial_cov_yy"            value="0.25"/>
    <param name="initial_cov_aa"            value="0.068"/>

    <param name="odom_model_type"           value="diff-corrected"/>
    <param name="odom_alpha1"               value="0.1"/>
    <param name="odom_alpha2"               value="0.1"/>
    <param name="odom_alpha3"               value="0.2"/>
    <param name="odom_alpha4"               value="0.2"/>
    <param name="odom_alpha5"               value="0.1"/>

    <param name="laser_model_type"          value="likelihood_field"/>
    <param name="laser_likelihood_max_dist" value="2.0"/>
    <param name="laser_min_range"           value="0.12"/>
    <param name="laser_max_range"           value="3.5"/>
    <param name="laser_max_beams"           value="180"/>
    <param name="laser_z_hit"               value="0.8"/>
    <param name="laser_z_short"             value="0.05"/>
    <param name="laser_z_max"               value="0.05"/>
    <param name="laser_z_rand"              value="0.1"/>
    <param name="laser_sigma_hit"           value="0.15"/>
    <param name="laser_lambda_short"        value="0.1"/>

    <param name="odom_frame_id"             value="odom"/>
    <param name="base_frame_id"             value="base_footprint"/>
    <param name="global_frame_id"           value="map"/>
    <param name="tf_broadcast"              value="true"/>

    <remap from="scan" to="/scan"/>
  </node>

  <!-- Hybrid navigator -->
  <node name="hybrid_navigator" pkg="py_hybrid_planner" type="hybrid_navigation.py"
        output="screen" respawn="false">
    <param name="goal_tolerance"         value="0.20"/>
    <param name="lookahead"              value="0.5"/>
    <param name="replan_period"          value="4.0"/>
    <param name="emergency_front_dist"   value="0.18"/>
  </node>

  <!-- RViz -->
  <node name="rviz" pkg="rviz" type="rviz"
        args="-d $(find py_hybrid_planner)/config/hybrid_nav.rviz"
        if="$(arg open_rviz)"/>
</launch>
