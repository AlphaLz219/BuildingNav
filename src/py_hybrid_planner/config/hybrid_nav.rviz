Panels:
  - Class: rviz/Displays
    Name: Displays
  - Class: rviz/Tool Properties
    Name: Tool Properties
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz/Grid
      Name: Grid
      Plane Cell Count: 50
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz/Map
      Name: Map
      Topic: /map
      Value: true
      Alpha: 0.7
    - Class: rviz/RobotModel
      Name: RobotModel
      Robot Description: robot_description
      Value: true
    - Class: rviz/LaserScan
      Name: LaserScan
      Topic: /scan
      Value: true
      Size (m): 0.03
      Color: 255; 0; 0
    - Class: rviz/Path
      Name: GlobalPath
      Topic: /hybrid_global_path
      Value: true
      Color: 0; 0; 255
      Line Style: Lines
      Line Width: 0.03
    - Class: rviz/MarkerArray
      Name: KeyPoints
      Topic: /hybrid_key_points
      Value: true
    - Class: rviz/Marker
      Name: LocalTarget
      Topic: /hybrid_local_target
      Value: true
    - Class: rviz/PoseArray
      Name: ParticleCloud
      Topic: /particlecloud
      Value: true
      Arrow Length: 0.05
      Color: 0; 255; 0
    - Class: rviz/TF
      Name: TF
      Value: true
      Show Axes: true
      Show Names: false
      Frame Timeout: 15
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Tools:
    - Class: rviz/MoveCamera
    - Class: rviz/Interact
    - Class: rviz/SetInitialPose
      Topic: /initialpose
    - Class: rviz/SetGoal
      Topic: /move_base_simple/goal
  Value: true
  Views:
    Current:
      Class: rviz/ThirdPersonFollower
      Distance: 8
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 0.7
      Value: ThirdPersonFollower (Orbital)
Window Geometry:
  Displays:
    collapsed: false
  Height: 800
  Width: 1200
