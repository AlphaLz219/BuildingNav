<?xml version="1.0"?>
<launch>
  <!--
    Stage 2: navigation stack for the ASK-3 quadruped.
      - map_server publishes the static OccupancyGrid (same map as the
        wheeled experiment).
      - AMCL localises map -> odom from the ASK-3 Gazebo lidar /scan.
      - fake_scan_from_map is kept as an optional fallback when testing
        without the URDF lidar.
      - dog_hybrid_navigator runs improved A* + omnidirectional DWA and
        publishes the dog's three-channel velocity interface.
  -->

  <arg name="map_file"   default="$(find dog_hybrid_planner)/maps/map.yaml"/>
  <arg name="open_rviz"  default="true"/>
  <arg name="rname"      default="ask_3"/>
  <arg name="gazebo_model" default="mydog"/>
  <arg name="base_frame" default="base"/>
  <arg name="use_amcl"   default="true"/>
  <arg name="use_fake_scan" default="false"/>
  <arg name="initial_x"   default="0.8"/>
  <arg name="initial_y"   default="0.8"/>
  <arg name="initial_yaw" default="0.7854"/>
  <arg name="inflate_radius" default="0.28"/>
  <arg name="robot_radius"   default="0.24"/>
  <arg name="hard_radius"    default="0.13"/>
  <arg name="auto_enable_idle" default="false"/>
  <arg name="enable_low_level_gait" default="true"/>

  <node name="map_server" pkg="map_server" type="map_server"
        args="$(arg map_file)"/>

  <node name="gt_pose_bridge" pkg="dog_hybrid_planner"
        type="gt_pose_bridge.py" output="screen"
        unless="$(arg use_amcl)">
    <param name="model_name"    value="$(arg gazebo_model)"/>
    <param name="parent_frame"  value="map"/>
    <param name="child_frame"   value="odom"/>
    <param name="identity_only" value="true"/>
    <param name="publish_rate"  value="30.0"/>
  </node>

  <node pkg="amcl" type="amcl" name="amcl" output="screen"
        if="$(arg use_amcl)">
    <param name="min_particles"             value="800"/>
    <param name="max_particles"             value="5000"/>
    <param name="kld_err"                   value="0.02"/>
    <param name="kld_z"                     value="0.99"/>
    <param name="update_min_d"              value="0.12"/>
    <param name="update_min_a"              value="0.12"/>
    <param name="resample_interval"         value="2"/>
    <param name="transform_tolerance"       value="0.2"/>
    <param name="recovery_alpha_slow"       value="0.001"/>
    <param name="recovery_alpha_fast"       value="0.1"/>
    <param name="gui_publish_rate"          value="10.0"/>
    <param name="save_pose_rate"            value="-1.0"/>
    <param name="always_reset_initial_pose" value="true"/>

    <param name="initial_pose_x"            value="$(arg initial_x)"/>
    <param name="initial_pose_y"            value="$(arg initial_y)"/>
    <param name="initial_pose_a"            value="$(arg initial_yaw)"/>
    <param name="initial_cov_xx"            value="0.02"/>
    <param name="initial_cov_yy"            value="0.02"/>
    <param name="initial_cov_aa"            value="0.01"/>

    <param name="odom_model_type"           value="omni-corrected"/>
    <param name="odom_alpha1"               value="0.08"/>
    <param name="odom_alpha2"               value="0.08"/>
    <param name="odom_alpha3"               value="0.12"/>
    <param name="odom_alpha4"               value="0.12"/>
    <param name="odom_alpha5"               value="0.08"/>

    <param name="laser_model_type"          value="likelihood_field"/>
    <param name="laser_likelihood_max_dist" value="2.0"/>
    <param name="laser_min_range"           value="0.12"/>
    <param name="laser_max_range"           value="6.0"/>
    <param name="laser_max_beams"           value="240"/>
    <param name="laser_z_hit"               value="0.8"/>
    <param name="laser_z_short"             value="0.05"/>
    <param name="laser_z_max"               value="0.05"/>
    <param name="laser_z_rand"              value="0.1"/>
    <param name="laser_sigma_hit"           value="0.15"/>
    <param name="laser_lambda_short"        value="0.1"/>

    <param name="odom_frame_id"             value="odom"/>
    <param name="base_frame_id"             value="$(arg base_frame)"/>
    <param name="global_frame_id"           value="map"/>
    <param name="tf_broadcast"              value="true"/>

    <remap from="scan" to="/scan"/>
  </node>

  <node name="dog_initial_pose_publisher" pkg="dog_hybrid_planner"
        type="publish_initial_pose.py" output="screen"
        if="$(arg use_amcl)">
    <param name="x" value="$(arg initial_x)"/>
    <param name="y" value="$(arg initial_y)"/>
    <param name="yaw" value="$(arg initial_yaw)"/>
    <param name="delay" value="1.0"/>
    <param name="repeats" value="8"/>
    <param name="rate" value="2.0"/>
  </node>

  <node name="fake_scan_from_map" pkg="dog_hybrid_planner"
        type="fake_scan_from_map.py" output="screen"
        if="$(arg use_fake_scan)">
    <param name="global_frame" value="map"/>
    <param name="base_frame"   value="$(arg base_frame)"/>
    <param name="scan_frame"   value="$(arg base_frame)"/>
    <param name="rate"         value="8.0"/>
    <param name="range_max"    value="6.0"/>
  </node>

  <node name="dog_hybrid_navigator" pkg="dog_hybrid_planner"
        type="dog_navigation.py" output="screen" respawn="false">
    <param name="goal_tolerance"       value="0.30"/>
    <param name="lookahead"            value="0.50"/>
    <param name="replan_period"        value="5.0"/>
    <param name="periodic_replan"      value="true"/>
    <param name="path_switch_lock_time" value="0.0"/>
    <param name="replan_min_translation" value="0.12"/>
    <param name="replan_path_deviation" value="0.60"/>
    <param name="replan_max_yaw_rate"  value="0.18"/>
    <param name="path_switch_max_heading_deg" value="70.0"/>
    <param name="path_switch_max_lateral" value="0.30"/>
    <param name="path_switch_max_target_jump" value="0.55"/>
    <param name="emergency_front_dist" value="0.16"/>
    <param name="emergency_front_half_angle_deg" value="22.0"/>
    <param name="emergency_front_half_width"     value="0.09"/>
    <param name="self_filter_enabled"            value="true"/>
    <param name="self_filter_x_min"              value="-0.25"/>
    <param name="self_filter_x_max"              value="0.27"/>
    <param name="self_filter_half_width"         value="0.14"/>
    <param name="align_to_path"                  value="false"/>
    <param name="align_start_angle_deg"          value="22.0"/>
    <param name="align_finish_angle_deg"         value="8.0"/>
    <param name="align_path_lookahead"           value="0.60"/>
    <param name="align_max_duration"             value="3.0"/>
    <param name="align_cooldown"                 value="2.0"/>
    <param name="align_turn_clearance"           value="0.24"/>
    <param name="align_rear_clearance"           value="0.20"/>
    <param name="align_front_space"              value="0.28"/>
    <param name="align_side_clearance"           value="0.18"/>
    <param name="align_back_speed"               value="0.10"/>
    <param name="align_side_speed"               value="0.08"/>
    <param name="align_yaw_speed"                value="0.65"/>
    <param name="no_progress_recovery_clearance" value="0.45"/>
    <param name="no_progress_recovery_delay"     value="3.0"/>
    <param name="post_recovery_dwa_grace"        value="2.5"/>
    <param name="base_frame"           value="$(arg base_frame)"/>
    <param name="global_frame"         value="map"/>
    <param name="cmd_rate"             value="25.0"/>
    <param name="max_vx"               value="0.75"/>
    <param name="min_vx"               value="-0.12"/>
    <param name="max_vy"               value="0.26"/>
    <param name="min_vy"               value="-0.26"/>
    <param name="max_omega"            value="1.35"/>
    <param name="max_accel_xy"         value="2.8"/>
    <param name="max_domega"           value="3.4"/>
    <param name="predict_time"         value="1.35"/>
    <param name="max_decel_xy"         value="2.0"/>
    <param name="brake_margin"         value="0.02"/>
    <param name="inflate_radius"       value="$(arg inflate_radius)"/>
    <param name="astar_clearance_radius" value="0.50"/>
    <param name="astar_clearance_weight" value="1.25"/>
    <param name="astar_turn_weight" value="0.08"/>
    <param name="astar_shortcut_clearance" value="0.30"/>
    <param name="astar_resample_spacing" value="0.10"/>
    <param name="astar_chaikin_iterations" value="2"/>
    <param name="dwa_path_track_weight" value="0.18"/>
    <param name="dwa_path_corridor_width" value="0.55"/>
    <param name="dwa_heading_align" value="true"/>
    <param name="dwa_align_start_angle_deg" value="42.0"/>
    <param name="dwa_align_lookahead" value="0.45"/>
    <param name="dwa_align_turn_clearance" value="0.34"/>
    <param name="dwa_align_rear_clearance" value="0.22"/>
    <param name="dwa_align_front_space" value="0.26"/>
    <param name="dwa_align_side_scale" value="0.18"/>
    <param name="dwa_align_creep_speed" value="0.24"/>
    <param name="dwa_align_yaw_speed" value="1.15"/>
    <param name="min_cruise_vx" value="0.34"/>
    <param name="replan_cruise_vx" value="0.38"/>
    <param name="post_replan_fast_grace" value="1.3"/>
    <param name="cruise_front_clearance" value="0.60"/>
    <param name="cruise_max_yaw_rate" value="0.45"/>
    <param name="cruise_lateral_limit" value="0.16"/>
    <param name="use_cmd_velocity_state" value="true"/>
    <param name="cmd_velocity_blend" value="0.75"/>
    <param name="robot_radius"         value="$(arg robot_radius)"/>
    <param name="hard_radius"          value="$(arg hard_radius)"/>
    <param name="max_laser_points"     value="240"/>
    <param name="max_speed"            value="0.75"/>
    <param name="auto_enable_idle"     value="$(arg auto_enable_idle)"/>
    <param name="enable_low_level_gait" value="$(arg enable_low_level_gait)"/>
  </node>

  <node name="rviz" pkg="rviz" type="rviz"
        args="-d $(find dog_hybrid_planner)/config/dog_nav.rviz"
        if="$(arg open_rviz)"/>
</launch>
